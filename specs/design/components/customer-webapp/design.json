{
  "name": "customer-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "customer-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    15,
    16,
    17,
    18
  ],
  "description": "The Customer-facing hosted checkout and account area: pay a merchant by mobile money or card, optionally create an account to save payment methods, view a receipt, review payment history, and raise disputes. Does not expose any merchant or admin functionality; checkout itself works without signing in.",
  "dependencies": [
    {
      "kind": "component",
      "name": "payments-api",
      "description": "Checkout, saved payment methods, payment history and disputes.",
      "wiring": {
        "endpoint": {
          "component": "test91921-payments-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "PAYMENTS_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "test91921-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
