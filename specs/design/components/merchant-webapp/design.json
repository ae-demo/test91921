{
  "name": "merchant-webapp",
  "type": "web-application",
  "version": "0.1.0",
  "language": "TypeScript",
  "buildpack": "docker",
  "appPath": "merchant-webapp",
  "entrypoint": "deployment/web-application",
  "exposure": "internet",
  "stories": [
    1,
    2,
    3,
    4,
    5,
    6,
    7,
    8
  ],
  "description": "The Merchant's dashboard: sign up and KYC submission, generating checkout integration, viewing transactions, configuring the payout account, tracking payouts, issuing refunds, and a performance summary. Does not handle the customer-facing checkout itself or any admin function.",
  "dependencies": [
    {
      "kind": "component",
      "name": "payments-api",
      "description": "All merchant onboarding, transaction, payout and refund data.",
      "wiring": {
        "endpoint": {
          "component": "test91921-payments-api",
          "name": "http",
          "visibility": "project",
          "envBindings": {
            "address": "PAYMENTS_API_URL"
          }
        }
      }
    },
    {
      "kind": "platform-resource",
      "name": "user-auth",
      "resourceType": "thunder-app",
      "wiring": {
        "ref": "test91921-user-auth",
        "envBindings": {
          "client_id": "USER_AUTH_CLIENT_ID",
          "issuer": "USER_AUTH_ISSUER",
          "jwks_url": "USER_AUTH_JWKS_URL",
          "resource": "USER_AUTH_RESOURCE",
          "scopes": "USER_AUTH_SCOPES"
        }
      }
    }
  ],
  "skillsPinned": [
    "wireframes",
    "react-webapp",
    "oxygen-ui-design-system",
    "thunder-authentication"
  ]
}
