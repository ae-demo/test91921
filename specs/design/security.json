{
  "version": 3,
  "permissions": [
    {
      "resource": "merchants",
      "component": "payments-api",
      "description": "Merchant business profiles and their onboarding/verification status",
      "actions": [
        { "handle": "read", "description": "The caller's own merchant profile" },
        { "handle": "update", "description": "Update the caller's own merchant profile and payout account" },
        { "handle": "read-all", "description": "Every merchant" },
        { "handle": "review", "description": "Approve or reject a merchant's onboarding" },
        { "handle": "suspend", "description": "Suspend or reactivate a merchant" }
      ]
    },
    {
      "resource": "transactions",
      "component": "payments-api",
      "description": "Checkout payments from customers to merchants",
      "actions": [
        { "handle": "read", "description": "The caller's own payments" },
        { "handle": "read-mine", "description": "The caller's merchant's transactions" },
        { "handle": "read-all", "description": "Every transaction" },
        { "handle": "refund", "description": "Refund one of the caller's merchant's transactions" }
      ]
    },
    {
      "resource": "payouts",
      "component": "payments-api",
      "description": "Scheduled weekly settlements to merchants",
      "actions": [
        { "handle": "read", "description": "The caller's merchant's payouts" },
        { "handle": "read-all", "description": "Every payout" },
        { "handle": "manage", "description": "Trigger and manage payout runs" }
      ]
    },
    {
      "resource": "disputes",
      "component": "payments-api",
      "description": "Customer disputes raised against transactions",
      "actions": [
        { "handle": "create", "description": "Raise a dispute" },
        { "handle": "read", "description": "The caller's own disputes" },
        { "handle": "read-all", "description": "Every dispute" },
        { "handle": "resolve", "description": "Mediate and resolve a dispute" }
      ]
    },
    {
      "resource": "fees",
      "component": "payments-api",
      "description": "Platform transaction fee configuration",
      "actions": [
        { "handle": "read", "description": "Current fee configuration" },
        { "handle": "configure", "description": "Change the fee configuration" }
      ]
    },
    {
      "resource": "payment-methods",
      "component": "payments-api",
      "description": "A customer's saved mobile money or card payment methods",
      "actions": [
        { "handle": "manage", "description": "The caller's own saved payment methods" }
      ]
    }
  ],
  "groups": [
    { "name": "PlatformAdmins", "description": "Internal staff who run the payments platform" }
  ],
  "roles": [
    {
      "name": "Merchant",
      "description": "Signs up, integrates checkout, tracks transactions and payouts, and issues refunds.",
      "stories": [1, 2, 3, 4, 5, 6, 7, 8],
      "grants": ["merchants:read", "merchants:update", "transactions:read-mine", "transactions:refund", "payouts:read"],
      "enrolment": "self-service"
    },
    {
      "name": "PlatformAdmin",
      "description": "Reviews merchant onboarding, monitors transactions, runs payouts, mediates disputes and sets fees.",
      "stories": [9, 10, 11, 12, 13, 14],
      "grants": ["merchants:read-all", "merchants:review", "merchants:suspend", "transactions:read-all", "payouts:read-all", "payouts:manage", "disputes:read-all", "disputes:resolve", "fees:read", "fees:configure"],
      "assignTo": ["PlatformAdmins"]
    },
    {
      "name": "Customer",
      "description": "Pays merchants at checkout, saves payment methods, reviews payment history and raises disputes.",
      "stories": [15, 16, 17, 18],
      "grants": ["transactions:read", "payment-methods:manage", "disputes:create", "disputes:read"],
      "enrolment": "self-service"
    }
  ],
  "testUsers": [
    { "username": "test-platformadmin", "roles": ["PlatformAdmin"] }
  ]
}
